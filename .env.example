IMAGE_SEARCH_DATABASE_URL=postgresql+psycopg://image_search:change-me@localhost:5432/image_search
IMAGE_SEARCH_QDRANT_URL=http://localhost:6333
IMAGE_SEARCH_STORAGE_ROOT=var/objects
IMAGE_SEARCH_LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me

# Baseline: CLI arguments override these values.
IMAGE_SEARCH_BASELINE_TIMEOUT=15
IMAGE_SEARCH_BASELINE_RETRIES=2
IMAGE_SEARCH_BASELINE_WORKERS=1
IMAGE_SEARCH_BASELINE_MAX_BYTES=10485760
IMAGE_SEARCH_BASELINE_MAX_PIXELS=40000000
IMAGE_SEARCH_BASELINE_MODEL_NAME=google/siglip2-base-patch16-224
IMAGE_SEARCH_BASELINE_MODEL_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
IMAGE_SEARCH_BASELINE_KEYWORD_K1=1.2
IMAGE_SEARCH_BASELINE_KEYWORD_B=0.75
IMAGE_SEARCH_BASELINE_HYBRID_RRF_K=60
IMAGE_SEARCH_BASELINE_HYBRID_CANDIDATES=100

# Planner: install with uv sync --extra planner (add --extra baseline to keep baseline).
OPENAI_API_KEY=
IMAGE_SEARCH_PLANNER_MODEL=gpt-5-mini-2025-08-07
IMAGE_SEARCH_PLANNER_TIMEOUT=60
IMAGE_SEARCH_PLANNER_RETRIES=1
IMAGE_SEARCH_PLANNER_MAX_OUTPUT_TOKENS=4096
IMAGE_SEARCH_PLANNER_MAX_QUERY_CHARS=4000
# Optional USD per 1M tokens; leave unset until current prices are verified.
# IMAGE_SEARCH_PLANNER_INPUT_PRICE=
# IMAGE_SEARCH_PLANNER_CACHED_INPUT_PRICE=
# IMAGE_SEARCH_PLANNER_OUTPUT_PRICE=

# SigLIP2 embedding reuses the model/revision pinned in the existing image index.
IMAGE_SEARCH_EMBEDDING_MANIFEST=var/benchmark-v1/benchmark.json
IMAGE_SEARCH_EMBEDDING_INDEX_DIR=var/index-v1
IMAGE_SEARCH_EMBEDDING_CACHE_DIR=var/models
IMAGE_SEARCH_EMBEDDING_THREADS=4
IMAGE_SEARCH_EMBEDDING_BATCH_SIZE=8
