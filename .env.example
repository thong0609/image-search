IMAGE_SEARCH_DATABASE_URL=postgresql+psycopg://image_search:change-me@localhost:5432/image_search
IMAGE_SEARCH_QDRANT_URL=http://localhost:6333
IMAGE_SEARCH_STORAGE_ROOT=var/objects
IMAGE_SEARCH_LOG_LEVEL=INFO
POSTGRES_PASSWORD=change-me

# Baseline: CLI arguments override these values.
IMAGE_SEARCH_BASELINE_TIMEOUT=15
IMAGE_SEARCH_BASELINE_RETRIES=2
IMAGE_SEARCH_BASELINE_WORKERS=1
IMAGE_SEARCH_BASELINE_MAX_BYTES=10485760
IMAGE_SEARCH_BASELINE_MAX_PIXELS=40000000
IMAGE_SEARCH_BASELINE_MODEL_NAME=google/siglip2-base-patch16-224
IMAGE_SEARCH_BASELINE_MODEL_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
IMAGE_SEARCH_BASELINE_KEYWORD_K1=1.2
IMAGE_SEARCH_BASELINE_KEYWORD_B=0.75
IMAGE_SEARCH_BASELINE_HYBRID_RRF_K=60
IMAGE_SEARCH_BASELINE_HYBRID_CANDIDATES=100

# Planner: install with uv sync --extra planner (add --extra baseline to keep baseline).
OPENAI_API_KEY=
IMAGE_SEARCH_PLANNER_MODEL=gpt-5-mini-2025-08-07
IMAGE_SEARCH_PLANNER_TIMEOUT=60
IMAGE_SEARCH_PLANNER_RETRIES=1
IMAGE_SEARCH_PLANNER_MAX_OUTPUT_TOKENS=4096
# minimal, low, medium hoặc high.
IMAGE_SEARCH_PLANNER_REASONING_EFFORT=low
IMAGE_SEARCH_PLANNER_CACHE_SIZE=1000
IMAGE_SEARCH_PLANNER_MAX_QUERY_CHARS=4000
# Optional USD per 1M tokens; leave unset until current prices are verified.
# IMAGE_SEARCH_PLANNER_INPUT_PRICE=
# IMAGE_SEARCH_PLANNER_CACHED_INPUT_PRICE=
# IMAGE_SEARCH_PLANNER_OUTPUT_PRICE=

# SigLIP2 embedding reuses the model/revision pinned in the existing image index.
IMAGE_SEARCH_EMBEDDING_MANIFEST=var/benchmark-v1/benchmark.json
IMAGE_SEARCH_EMBEDDING_CACHE_DIR=var/models
IMAGE_SEARCH_EMBEDDING_THREADS=4
IMAGE_SEARCH_EMBEDDING_BATCH_SIZE=8

# Retrieval: equal-weight RRF; image + BM25, optionally record text.
IMAGE_SEARCH_RETRIEVAL_TOP_K=100
IMAGE_SEARCH_RETRIEVAL_CANDIDATES=100
IMAGE_SEARCH_RETRIEVAL_RRF_K=60
# Requires image-search-qdrant --sync-text; affects hybrid retrieval only.
IMAGE_SEARCH_RETRIEVAL_TEXT_VECTORS=false
IMAGE_SEARCH_RETRIEVAL_DEFAULT_COUNT=10
IMAGE_SEARCH_RETRIEVAL_LIST_SIZE=20
IMAGE_SEARCH_RETRIEVAL_BRIDGE_HYPOTHESES=3
IMAGE_SEARCH_RETRIEVAL_BRIDGE_IMAGES=3
IMAGE_SEARCH_RETRIEVAL_BRIDGE_MARGIN=0.1

# Vectors and index metadata are persisted only in Qdrant.
IMAGE_SEARCH_RETRIEVAL_QDRANT_COLLECTION=image_search_siglip2_v1

# Neo4j entity relation graph. Use a private password in .env (8+ characters).
IMAGE_SEARCH_GRAPH_URI=bolt://localhost:7687
IMAGE_SEARCH_GRAPH_USERNAME=neo4j
IMAGE_SEARCH_GRAPH_PASSWORD=change-me
IMAGE_SEARCH_GRAPH_DATABASE=neo4j
IMAGE_SEARCH_GRAPH_DATASET_ID=image-search
IMAGE_SEARCH_GRAPH_TIMEOUT=10
IMAGE_SEARCH_GRAPH_BATCH_SIZE=200

# Offline extraction uses OPENAI_API_KEY and IMAGE_SEARCH_PLANNER_MODEL.
IMAGE_SEARCH_GRAPH_WORKERS=4
IMAGE_SEARCH_GRAPH_MAX_INPUT_CHARS=24000
IMAGE_SEARCH_GRAPH_MAX_OUTPUT_TOKENS=8192
IMAGE_SEARCH_GRAPH_EXTRACTION_TIMEOUT=120

# Website auth: generate with image-search-admin init-key; never commit the private key.
IMAGE_SEARCH_AUTH_PRIVATE_KEY=var/auth/private.pem
# Local HTTP only. Set true behind HTTPS in production.
IMAGE_SEARCH_AUTH_COOKIE_SECURE=false
IMAGE_SEARCH_AUTH_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]

# Prepare search runtime and warm inference when the API starts (disable only in isolated tests).
IMAGE_SEARCH_PRELOAD_SEARCH=true

# Experimental local rules; off preserves the LLM planner.
IMAGE_SEARCH_PLANNER_LOCAL_MODE=off
